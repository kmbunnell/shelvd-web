@page "/register"
@using System.ComponentModel.DataAnnotations
@using Shelvd.Web.Common
@using Shelvd.Web.Services.Auth
@inject IAuthService AuthService
@inject IAuthCookieService AuthCookieService
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<div class="auth-container">
    <h1>Register</h1>

    @if (_errorMessage is not null)
    {
        <p class="validation-message" role="alert">@_errorMessage</p>
    }
    else if (_registeredSuccessfully)
    {
        <p role="status">Registration successful — check your email to confirm your account.</p>
    }
    else
    {
        <EditForm Model="Input!" FormName="register" OnValidSubmit="HandleRegisterAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <InputText id="email" class="form-control" @bind-Value="Input!.Email" />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="Input!.Password" />
            </div>
            <button type="submit" class="btn btn-primary">Register</button>
        </EditForm>

        <p class="mt-3">
            Already have an account? <a href="/login">Log in</a>
        </p>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterInput? Input { get; set; }

    private string? _errorMessage;
    private bool _registeredSuccessfully;

    protected override void OnInitialized() => Input ??= new RegisterInput();

    private async Task HandleRegisterAsync()
    {
        _errorMessage = null;
        var result = await AuthService.SignUpAsync(Input!.Email, Input.Password);

        switch (result)
        {
            case Result<AuthSession?, AuthError>.Failure failure:
                _errorMessage = AuthErrorMessages.For(failure.Error);
                break;
            case Result<AuthSession?, AuthError>.Success { Value: not null } success:
                await AuthCookieService.SignInAsync(success.Value);
                Navigation.NavigateTo("/", forceLoad: true);
                break;
            case Result<AuthSession?, AuthError>.Success { Value: null }:
                _registeredSuccessfully = true;
                break;
        }
    }

    private sealed class RegisterInput
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
