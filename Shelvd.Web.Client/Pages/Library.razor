@page "/"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Shelvd.Web.Shared.Common
@using Shelvd.Web.Client.Models
@using Shelvd.Web.Client.Services.Books
@inject IBooksApiClient BooksApiClient

<PageTitle>Library</PageTitle>

<h1>Library</h1>

@if (_result is null)
{
    <div class="loading-container" role="status">
        <div class="spinner" aria-hidden="true"></div>
        <span class="visually-hidden">Loading your books...</span>
    </div>
}
else if (_result is Result<IReadOnlyList<BookDto>, BooksApiError>.Failure)
{
    <p role="alert">An error occurred while loading your books. Please try again later.</p>
    <button @onclick="LoadBooksAsync">Retry</button>
}
else if (_result is Result<IReadOnlyList<BookDto>, BooksApiError>.Success success)
{
    if (success.Value.Count == 0)
    {
        <p>You have no books in your library yet.</p>
    }
    else
    {
        <div class="toolbar">
            <label for="sort-select">Sort by</label>
            <select id="sort-select" @bind="_sortOption">
                <option value="@SortOption.Title">Title (A&ndash;Z)</option>
                <option value="@SortOption.Author">Author (A&ndash;Z)</option>
            </select>
        </div>
        <ul class="book-grid">
            @foreach (var book in SortBooks(success.Value))
            {
                <li class="book-card" @key="book.Id">
                    <div class="book-cover">
                        <img src="@(book.CoverImageUrl ?? PlaceholderCoverUrl)" alt="Cover of @book.Title" />
                    </div>
                    <div class="book-info">
                        <span class="book-title">@book.Title</span>
                        <span class="book-authors">@string.Join(", ", book.Authors)</span>
                    </div>
                </li>
            }
        </ul>
    }
}

@code {
    private const string PlaceholderCoverUrl = "/images/placeholder-cover.webp";

    private Result<IReadOnlyList<BookDto>, BooksApiError>? _result;
    private CancellationTokenSource? _cts;
    private SortOption _sortOption = SortOption.Title;

    private enum SortOption
    {
        Title,
        Author
    }

    protected override Task OnInitializedAsync() => LoadBooksAsync();

    private IEnumerable<BookDto> SortBooks(IReadOnlyList<BookDto> books) => _sortOption switch
    {
        SortOption.Author => books.OrderBy(book => book.Authors.Count > 0 ? book.Authors[0] : string.Empty, StringComparer.OrdinalIgnoreCase),
        _ => books.OrderBy(book => book.Title, StringComparer.OrdinalIgnoreCase)
    };

    private async Task LoadBooksAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        _result = null;
        try
        {
            _result = await BooksApiClient.GetBooksAsync(_cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a subsequent LoadBooksAsync call (retry) or the component
            // was disposed before the fetch completed — either way, nothing to render.
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
