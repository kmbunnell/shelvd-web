@page "/"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Shelvd.Web.Shared.Common
@using Shelvd.Web.Client.Components
@using Shelvd.Web.Client.Models
@using Shelvd.Web.Client.Services.Books
@using Shelvd.Web.Client.Services.Tags
@inject IBooksApiClient BooksApiClient
@inject ITagsApiClient TagsApiClient

<PageTitle>Library</PageTitle>

<h1>Library</h1>

@if (_result is null)
{
    <div class="loading-container" role="status">
        <div class="spinner" aria-hidden="true"></div>
        <span class="visually-hidden">Loading your books...</span>
    </div>
}
else if (_result is Result<IReadOnlyList<BookDto>, BooksApiError>.Failure)
{
    <p role="alert">An error occurred while loading your books. Please try again later.</p>
    <button @onclick="LoadBooksAsync">Retry</button>
}
else if (_result is Result<IReadOnlyList<BookDto>, BooksApiError>.Success success)
{
    if (success.Value.Count == 0)
    {
        <p>You have no books in your library yet.</p>
    }
    else
    {
        <div class="toolbar">
             <div class="tag-filter-wrapper">
                <button type="button" class="tag-filter-button" @ref="_tagFilterButtonRef" @onclick="ToggleTagPopover" aria-haspopup="dialog">
                    <span aria-hidden="true">&#127991;</span>
                    <span class="visually-hidden">
                        @(_selectedTagIds.Count > 0 ? $"Filter by tag, {_selectedTagIds.Count} selected" : "Filter by tag")
                    </span>
                    @if (_selectedTagIds.Count > 0)
                    {
                        <span class="tag-filter-count" aria-hidden="true">@_selectedTagIds.Count</span>
                    }
                </button>
                <TagFilterPopover
                    IsOpen="_isTagPopoverOpen"
                    Status="TagsStatus"
                    Tags="AvailableTags"
                    SelectedTagIds="_selectedTagIds"
                    OnSelectionChanged="HandleTagFilterSelectionChanged"
                    OnDone="HandleTagFilterDone"
                    OnDismiss="HandleTagFilterDismiss"
                    OnRetry="LoadTagsAsync" />
            </div>
             <label for="sort-select" class="visually-hidden">Sort by</label>
            <select id="sort-select" @bind="_sortOption">
                <option value="@SortOption.Title">Title (A&ndash;Z)</option>
                <option value="@SortOption.Author">Author (A&ndash;Z)</option>
            </select>
        </div>
        <ul class="book-grid">
            @foreach (var book in FilterBooks(SortBooks(success.Value)))
            {
                <li class="book-card" @key="book.Id">
                    <a href="@($"/books/{book.Id}")">
                        <div class="book-cover">
                            <img src="@(book.CoverImageUrl ?? BookCoverDefaults.PlaceholderCoverUrl)" alt="Cover of @book.Title" />
                        </div>
                        <div class="book-info">
                            <span class="book-title">@book.Title</span>
                            <span class="book-authors">@string.Join(", ", book.Authors)</span>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }
}

@code {
    private Result<IReadOnlyList<BookDto>, BooksApiError>? _result;
    private Result<IReadOnlyList<TagDto>, TagsApiError>? _tagsResult;
    private CancellationTokenSource? _cts;
    private CancellationTokenSource? _tagsCts;
    private SortOption _sortOption = SortOption.Title;
    private bool _isTagPopoverOpen;
    private IReadOnlyList<Guid> _selectedTagIds = [];
    private ElementReference _tagFilterButtonRef;

    private enum SortOption
    {
        Title,
        Author
    }

    private IReadOnlyList<TagDto> AvailableTags =>
        _tagsResult is Result<IReadOnlyList<TagDto>, TagsApiError>.Success success ? success.Value : [];

    private TagFilterPopover.TagsLoadStatus TagsStatus => _tagsResult switch
    {
        null => TagFilterPopover.TagsLoadStatus.Loading,
        Result<IReadOnlyList<TagDto>, TagsApiError>.Success => TagFilterPopover.TagsLoadStatus.Loaded,
        _ => TagFilterPopover.TagsLoadStatus.Failed
    };

    protected override async Task OnInitializedAsync()
    {
        _ = LoadTagsAsync();
        await LoadBooksAsync();
    }

    private IEnumerable<BookDto> SortBooks(IReadOnlyList<BookDto> books) => _sortOption switch
    {
        SortOption.Author => books.OrderBy(book => book.Authors.Count > 0 ? book.Authors[0] : string.Empty, StringComparer.OrdinalIgnoreCase),
        _ => books.OrderBy(book => book.Title, StringComparer.OrdinalIgnoreCase)
    };

    private IEnumerable<BookDto> FilterBooks(IEnumerable<BookDto> books) =>
        _selectedTagIds.Count == 0
            ? books
            : books.Where(book => _selectedTagIds.All(tagId => book.Tags.Any(tag => tag.Id == tagId)));

    private async Task LoadBooksAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        _result = null;
        try
        {
            _result = await BooksApiClient.GetBooksAsync(_cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a subsequent LoadBooksAsync call (retry) or the component
            // was disposed before the fetch completed — either way, nothing to render.
        }
    }

    private async Task LoadTagsAsync()
    {
        _tagsCts?.Cancel();
        _tagsCts?.Dispose();
        _tagsCts = new CancellationTokenSource();

        try
        {
            _tagsResult = await TagsApiClient.GetTagsAsync(_tagsCts.Token);
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // The component was disposed before the fetch completed — nothing to render.
        }
    }

    private void ToggleTagPopover() => _isTagPopoverOpen = !_isTagPopoverOpen;

    private void HandleTagFilterSelectionChanged(IReadOnlyList<Guid> selectedTagIds) =>
        _selectedTagIds = selectedTagIds;

    private async Task HandleTagFilterDone()
    {
        _isTagPopoverOpen = false;
        await _tagFilterButtonRef.FocusAsync();
    }

    private async Task HandleTagFilterDismiss()
    {
        _isTagPopoverOpen = false;
        await _tagFilterButtonRef.FocusAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _tagsCts?.Cancel();
        _tagsCts?.Dispose();
    }
}
