@page "/books/{Id:guid}"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Shelvd.Web.Shared.Common
@using Shelvd.Web.Client.Models
@using Shelvd.Web.Client.Services.BookTags
@using Shelvd.Web.Client.Services.Books
@using Shelvd.Web.Client.Services.Tags
@inject IBooksApiClient BooksApiClient
@inject ITagsCache TagsCache
@inject IBookTagsApiClient BookTagsApiClient
@inject NavigationManager Navigation

<PageTitle>Tag Book</PageTitle>

<div class="page-header">
    <a class="back-button" href="#" @onclick="NavigateBack" @onclick:preventDefault aria-label="Back to Library">
        <span aria-hidden="true">&#8592;</span>
    </a>
    <h1>Tag Book</h1>
</div>
<div class="page-container">
    @if (_result is null)
    {
        <div class="loading-container" role="status">
            <div class="spinner" aria-hidden="true"></div>
            <span class="visually-hidden">Loading book...</span>
        </div>
    }
    else if (_result is Result<BookDto, BooksApiError>.Failure failure)
    {
        if (failure.Error == BooksApiError.NotFound)
        {
            <p>Book not found.</p>
            <a class="back-home-link" href="/">Back to Library</a>
        }
        else
        {
            <p role="alert">An error occurred while loading this book. Please try again later.</p>
            <button class="retry-button" @onclick="LoadBookAsync">Retry</button>
        }
    }
    else if (_result is Result<BookDto, BooksApiError>.Success success)
    {
        var book = success.Value;
        <div class="book-details-content" inert="@_confirmingDelete">
            <div class="book-cover">
                <div class="cover-frame">
                    <img src="@(book.CoverImageUrl ?? BookCoverDefaults.PlaceholderCoverUrl)" alt="Cover of @book.Title" />
                    <button type="button" class="delete-button" aria-label="Delete book from library" @onclick="RequestDelete">
                        <span aria-hidden="true">&#128465;&#65038;</span>
                    </button>
                </div>
            </div>
            <div class="status-strip" role="alert">
                @if (_deleteFailed)
                {
                    <span>Couldn't delete this book.</span>
                    <button type="button" class="retry-link" @onclick="() => ConfirmDeleteAsync(book)">Retry</button>
                    <button type="button" class="dismiss-link" aria-label="Dismiss" @onclick="DismissDeleteFailure">&times;</button>
                }
                else if (_lastFailedTag is { } failedTag)
                {
                    <span>Couldn't update "@failedTag.Name".</span>
                    <button type="button" class="retry-link" @onclick="() => ToggleTagAsync(book, failedTag)">Retry</button>
                }
            </div>
            @if (_tagsLoader?.Result is Result<IReadOnlyList<TagDto>, TagsApiError>.Failure)
            {
                <p class="error-state" role="alert">Couldn't load tags.</p>
                <button type="button" class="retry-button" @onclick="ReloadTagsAsync">Retry</button>
            }
            else
            {
                <ul class="tag-grid">
                    @foreach (var tag in AvailableTags)
                    {
                        <li class="tag-chip-item" @key="tag.Id">
                            <button type="button" class="tag-chip @(IsTagged(book, tag) ? "tag-chip-selected" : "") @(_pendingTagIds.Contains(tag.Id) ? "tag-chip-pending" : "") @(_failedTagIds.Contains(tag.Id) ? "tag-chip-error" : "")" aria-pressed="@(IsTagged(book, tag) ? "true" : "false")" @onclick="() => ToggleTagAsync(book, tag)">@tag.Name</button>
                        </li>
                    }
                </ul>
            }
            <button type="button" class="manage-tags-button">Manage Tags</button>
        </div>
        @if (_confirmingDelete)
        {
            <div class="delete-confirm-overlay" @onclick="CancelDelete">
                <div class="delete-confirm" role="alertdialog" aria-modal="true" aria-labelledby="delete-confirm-heading" @onclick:stopPropagation="true">
                    <p id="delete-confirm-heading">Delete this book from your library?</p>
                    <div class="delete-confirm-actions">
                        <button type="button" class="confirm-delete-button" disabled="@_deleteInFlight" @onclick="() => ConfirmDeleteAsync(book)">Delete</button>
                        <button type="button" class="cancel-delete-button" disabled="@_deleteInFlight" @onclick="CancelDelete">Cancel</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Result<BookDto, BooksApiError>? _result;
    private TagsLoader? _tagsLoader;
    private CancellationTokenSource? _cts;
    private Guid? _loadedId;
    private readonly HashSet<Guid> _pendingTagIds = [];
    private readonly HashSet<Guid> _failedTagIds = [];
    private TagDto? _lastFailedTag;
    private bool _confirmingDelete;
    private bool _deleteInFlight;
    private bool _deleteFailed;

    private IReadOnlyList<TagDto> AvailableTags =>
        _tagsLoader?.Result is Result<IReadOnlyList<TagDto>, TagsApiError>.Success success ? success.Value : [];

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;
        _loadedId = Id;
        _pendingTagIds.Clear();
        _failedTagIds.Clear();
        _lastFailedTag = null;
        _confirmingDelete = false;
        _deleteInFlight = false;
        _deleteFailed = false;

        _tagsLoader ??= new TagsLoader(TagsCache);
        _ = ReloadTagsAsync();
        await LoadBookAsync();
    }

    private Task ReloadTagsAsync() => _tagsLoader!.LoadAsync(StateHasChanged);

    private static bool IsTagged(BookDto book, TagDto tag) => book.Tags.Any(t => t.Id == tag.Id);

    private async Task ToggleTagAsync(BookDto book, TagDto tag)
    {
        if (_confirmingDelete || _pendingTagIds.Contains(tag.Id)) return;

        var loadedId = _loadedId;
        var wasTagged = IsTagged(book, tag);
        _failedTagIds.Remove(tag.Id);
        if (_lastFailedTag?.Id == tag.Id) _lastFailedTag = null;
        _pendingTagIds.Add(tag.Id);
        ApplyTagChange(tag, add: !wasTagged);

        Result<BookTagsApiError> result;
        try
        {
            result = wasTagged
                ? await BookTagsApiClient.UntagBookAsync(book.Id, tag.Id, _cts?.Token ?? default)
                : await BookTagsApiClient.TagBookAsync(book.Id, tag.Id, _cts?.Token ?? default);
        }
        catch (OperationCanceledException)
        {
            // Superseded by navigating to a different book or the component being disposed.
            return;
        }

        if (loadedId != _loadedId) return;

        _pendingTagIds.Remove(tag.Id);
        if (result is Result<BookTagsApiError>.Failure)
        {
            _failedTagIds.Add(tag.Id);
            _lastFailedTag = tag;
            ApplyTagChange(tag, add: wasTagged);
        }
    }

    // Derives from the current _result rather than a snapshot captured when the toggle
    // started, so a concurrent toggle of a different tag can't be clobbered by this one's
    // apply/revert (see the two-tags-in-flight regression test).
    private void ApplyTagChange(TagDto tag, bool add)
    {
        if (_result is not Result<BookDto, BooksApiError>.Success success) return;

        var tags = success.Value.Tags;
        var updated = add
            ? (tags.Any(t => t.Id == tag.Id) ? tags : [.. tags, tag])
            : tags.Where(t => t.Id != tag.Id).ToList();
        SetBookTags(updated);
    }

    private void SetBookTags(IReadOnlyList<TagDto> tags)
    {
        if (_result is Result<BookDto, BooksApiError>.Success success)
        {
            _result = new Result<BookDto, BooksApiError>.Success(success.Value with { Tags = tags });
        }
    }

    private void NavigateBack() => Navigation.NavigateTo("/");

    private void RequestDelete()
    {
        _confirmingDelete = true;
        _deleteFailed = false;
    }

    private void CancelDelete()
    {
        if (_deleteInFlight) return;
        _confirmingDelete = false;
    }

    private void DismissDeleteFailure() => _deleteFailed = false;

    private async Task ConfirmDeleteAsync(BookDto book)
    {
        _deleteInFlight = true;
        _deleteFailed = false;

        Result<BooksApiError> result;
        try
        {
            result = await BooksApiClient.DeleteBookAsync(book.Id, _cts?.Token ?? default);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (result is Result<BooksApiError>.Success)
        {
            Navigation.NavigateTo("/");
            return;
        }

        _deleteInFlight = false;
        // Confirmation is a one-time gate on the initial ask, not re-shown on retry:
        // the user already confirmed intent to delete, so Retry re-attempts the same
        // delete directly rather than asking again.
        _confirmingDelete = false;
        _deleteFailed = true;
    }

    private async Task LoadBookAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        _result = null;
        try
        {
            _result = await BooksApiClient.GetBookAsync(Id, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a subsequent LoadBookAsync call (retry) or the component
            // was disposed before the fetch completed — either way, nothing to render.
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _tagsLoader?.Dispose();
    }
}
